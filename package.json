{
  "name": "flexible-grading-system",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "client"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:server dev:client",
    "dev:client": "npm --workspace client run dev",
    "dev:server": "python -m uvicorn server.app.main:app --reload --host 127.0.0.1 --port 8000",
    "build": "npm --workspace client run build",
    "start": "python -m uvicorn server.app.main:app --host 0.0.0.0 --port 8000"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
